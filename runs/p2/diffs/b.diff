new file mode 100644
index 0000000..a5e1cc0
--- /dev/null
+++ b/src/ui/timeline.css
@@ -0,0 +1,156 @@
+.decision-log {
+  max-width: 100%;
+  min-width: 0;
+  overflow-wrap: anywhere;
+}
+
+.timeline-summary {
+  margin: 0 0 8px;
+  font-size: 20px;
+}
+
+.timeline-kicker,
+.strip-label,
+.event-stage {
+  margin: 14px 0 6px;
+  font: 600 12px/1.2 ui-sans-serif, system-ui, sans-serif;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted, #c3bba6);
+}
+
