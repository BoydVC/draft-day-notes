+  margin: 12px 0 4px;
+  letter-spacing: 0.04em;
+  text-transform: none;
+  font-size: 16px;
+  font-family: Georgia, "Iowan Old Style", Palatino, serif;
+  color: var(--ink, #f4f0e4);
+}
+
+.stage-list {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 4px 0;
+  margin: 0 0 8px;
+  padding: 0;
+  list-style: none;
+}
+
+.stage-list li {
+  margin: 0;
+}
+
+.stage-list li + li::before {
+  content: "·";
+  margin: 0 8px;
+  color: var(--muted, #c3bba6);
+}
+
+.runs-scroll {
+  width: 100%;
+  max-width: 100%;
+  min-width: 0;
+  overflow-x: auto;
+}
+
+.runs-scroll table {
+  width: max-content;
+  min-width: 100%;
+}
+
+.runs-scroll caption {
+  caption-side: top;
+  text-align: left;
+  font: 600 12px/1.2 ui-sans-serif, system-ui, sans-serif;
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--muted, #c3bba6);
+  margin: 0 0 6px;
+}
+
+.runs-scroll th,
+.runs-scroll td {
+  white-space: nowrap;
+}
+
+.timeline-strip {
+  display: grid;
+  gap: 8px;
+  margin: 12px 0 4px;
+}
+
+.stage-strip {
+  display: grid;
+  gap: 2px;
+}
+
+.strip-label {
+  margin: 0;
+}
+
+.stage-track {
+  position: relative;
+  width: 100%;
+  overflow: hidden;
+}
+
+.run-lane {
+  position: relative;
+  height: 18px;
+  margin: 1px 0;
+}
+
+.run-bar {
+  position: absolute;
+  top: 1px;
+  left: var(--start, 0%);
+  width: var(--width, 0%);
+  height: 16px;
+  max-width: 100%;
+  box-sizing: border-box;
+  border-radius: 4px;
+  padding: 0 4px;
+  overflow: hidden;
+  white-space: nowrap;
+  text-overflow: ellipsis;
+  background: var(--gold, #f0c14a);
+  color: #1b1608;
+  font: 600 10px/16px ui-sans-serif, system-ui, sans-serif;
+}
+
+.run-bar[data-outcome="errored"],
+.run-bar[data-outcome="not_verified"],
+.run-bar[data-outcome="abandoned"] {
+  background: var(--red, #ef7d6a);
+  color: #2a100c;
+}
+
+.run-bar[data-outcome="running"],
+.run-bar[data-outcome="inconclusive"] {
+  background: var(--blue, #8eb6e0);
+  color: #102033;
+}
+
+.run-bar[data-outcome="finished"],
+.run-bar[data-outcome="verified"],
+.run-bar[data-outcome="scored"],
+.run-bar[data-outcome="pr_opened"] {
+  background: var(--green, #8fce6a);
+  color: #10200c;
+}
+
+.event-groups {
+  margin: 0;
+  padding: 0;
+}
+
+.event-item {
+  margin: 4px 0 4px 16px;
+}
+
+.event-item a {
+  margin-left: 4px;
+  font-family: ui-sans-serif, system-ui, sans-serif;
+  font-size: 14px;
+}
diff --git a/src/ui/timeline.js b/src/ui/timeline.js
new file mode 100644
index 0000000..b109450
--- /dev/null
+++ b/src/ui/timeline.js
@@ -0,0 +1,99 @@
+function startedLabel(value) {
+  const date = new Date(value);
+  if (Number.isNaN(date.getTime())) return String(value);
+  return date.toLocaleTimeString(undefined, { hour: "numeric", minute: "2-digit" });
+}
+
+function agentCell(run, el) {
+  if (run.agentUrl) {
+    return el("a", {
+      href: run.agentUrl,
+      target: "_blank",
+      rel: "noopener noreferrer",
+    }, [`Agent ${run.label}`]);
+  }
+  return run.agentId || "";
+}
+
+function eventItem(entry, el) {
+  const children = [`+${entry.sinceStartText} ${entry.title}`];
+  for (const link of entry.links) {
+    children.push(" ");
+    children.push(el("a", {
+      href: link.href,
+      target: "_blank",
+      rel: "noopener noreferrer",
+    }, [link.label]));
+  }
+  return el("div", { role: "listitem", class: "event-item" }, children);
+}
+
+function renderStrip(view, el) {
+  const blocks = [];
+  for (const span of view.stages) {
+    if (!span.bars || span.bars.length === 0) continue;
+    const lanes = span.bars.map((bar) => {
+      const pill = el("div", {
+        class: "run-bar",
+        "data-role": bar.role,
+        "data-outcome": bar.outcome,
+        "aria-label": `${bar.label} ${bar.outcome}`,
+      }, [bar.label]);
+      pill.style.setProperty("--start", `${bar.startPct}%`);
+      pill.style.setProperty("--width", `${bar.widthPct}%`);
+      return el("div", { class: "run-lane" }, [pill]);
+    });
+    const caption = span.kind === "terminal" ? span.stage : `${span.stage} ${span.durationText}`;
+    blocks.push(el("div", { class: "stage-strip" }, [
+      el("p", { class: "strip-label" }, [caption]),
+      el("div", { class: "stage-track" }, lanes),
+    ]));
+  }
+  return el("div", { class: "timeline-strip", "aria-label": "Run bars" }, blocks);
+}
+
+function renderDecisionLog(pick, el) {
+  const view = pick && pick.timeline;
+  if (!view) return [el("p", { class: "empty" }, ["No events."])];
+  const bySeq = new Map(view.entries.map((entry) => [entry.seq, entry]));
+  const summary = el("p", { class: "timeline-summary" }, [view.summary]);
+  const stages = el("ul", { "aria-label": "Stages", class: "stage-list" }, view.stages.map((span) => {
+    const text = span.kind === "terminal" ? span.stage : `${span.stage} ${span.durationText}`;
+    return el("li", {}, [text]);
+  }));
+  const rows = view.runs.length
+    ? view.runs.map((run) => el("tr", {}, [
+      el("td", {}, [run.label]),
+      el("td", {}, [agentCell(run, el)]),
+      el("td", {}, [startedLabel(run.startedAt)]),
+      el("td", {}, [run.durationText]),
+      el("td", {}, [run.outcome]),
+    ]))
+    : [el("tr", {}, [el("td", { colspan: "5", class: "empty" }, ["No runs."])])];
+  const table = el("table", { "aria-label": "Runs" }, [
+    el("caption", {}, ["Runs"]),
+    el("thead", {}, [el("tr", {}, ["Run", "Agent", "Started", "Duration", "Outcome"].map((name) => el("th", {}, [name])))]),
+    el("tbody", {}, rows),
+  ]);
+  const eventNodes = [];
+  for (const span of view.stages) {
+    const items = [];
+    for (const seq of span.entrySeqs || []) {
+      const entry = bySeq.get(seq);
+      if (entry) items.push(eventItem(entry, el));
+    }
+    if (!items.length) continue;
+    eventNodes.push(el("h3", { class: "event-stage" }, [span.stage]));
+    for (const item of items) eventNodes.push(item);
+  }
+  const events = el("div", { role: "list", "aria-label": "Events", class: "event-groups" }, eventNodes);
+  return [el("div", { class: "decision-log" }, [
+    summary,
+    el("h3", { class: "timeline-kicker" }, ["Stages"]),
+    stages,
+    el("div", { class: "runs-scroll" }, [table]),
+    renderStrip(view, el),
+    el("h3", { class: "timeline-kicker" }, ["Events"]),
+    events,
+  ])];
+}
