+    [3_599_999, "59m"],
+    [3_600_000, "1h 00m"],
+    [3_900_000, "1h 05m"],
+    [86_399_999, "23h 59m"],
+    [86_400_000, "1d 0h"],
+    [90_000_000, "1d 1h"],
+  ];
