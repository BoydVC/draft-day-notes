@@ -140,3 +140,97 @@ ol.events li { margin: 6px 0; }
 .empty { color: var(--muted); }
 
 .back { font-family: ui-sans-serif, system-ui, sans-serif; }
+
+.score-tools {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+  align-items: center;
+  margin-bottom: 8px;
+}
+
+.score-chip {
+  text-transform: none;
+  letter-spacing: 0.01em;
+  font-size: 13px;
+}
+
+.base-banner {
+  font: 700 15px/1 ui-sans-serif, system-ui, sans-serif;
+}
+
+.pass-toggle { display: inline-flex; gap: 6px; }
+
+.pass-toggle button {
+  background: transparent;
+  color: var(--ink);
+  border: 1px solid var(--line);
+  padding: 8px 14px;
+}
+
+.pass-toggle button[aria-pressed="true"] {
+  background: var(--gold);
+  color: #1b1608;
+  border-color: var(--gold);
+}
+
+.score-reason { margin: 8px 0 12px; font-size: 18px; }
+.score-judge, .score-note, .score-unstable, .score-showing { margin: 4px 0 8px; }
+.score-note { color: var(--muted); }
+
+.score-board {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
+  gap: 10px;
+}
+
+.score-col {
+  border: 1px solid var(--line);
+  border-radius: 12px;
+  padding: 12px;
+  background: #141b12;
+  min-width: 0;
+}
+
+.score-col[data-base="true"] {
+  border-color: var(--gold);
+  box-shadow: inset 0 0 0 1px var(--gold);
+}
+
+.score-col h3 {
+  margin: 0;
+  font-size: 20px;
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  align-items: center;
+}
+
+.base-mark {
+  font: 700 12px/1 ui-sans-serif, system-ui, sans-serif;
+  letter-spacing: 0.08em;
+  background: var(--gold);
+  color: #1b1608;
+  border-radius: 999px;
+  padding: 3px 8px;
+}
+
+.angle { margin: 4px 0 8px; color: var(--muted); }
+
+.score-col dl { margin: 0; }
+.score-col dl div { margin: 0 0 8px; }
+.score-col dt {
+  font: 600 12px/1.3 ui-sans-serif, system-ui, sans-serif;
+  color: var(--muted);
+}
+.score-col dd { margin: 0; overflow-wrap: anywhere; }
+
+@media (max-width: 480px) {
+  .score-board { grid-template-columns: 1fr; }
+  .score-col[data-base="true"] { order: -1; }
+  .score-reason { font-size: 17px; }
+  .score-col { padding: 12px; }
+  .score-col h3 { font-size: 22px; }
+  .pass-toggle { width: 100%; }
+  .pass-toggle button { flex: 1; }
+}